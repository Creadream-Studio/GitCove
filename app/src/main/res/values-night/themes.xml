<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 深色启动主题（MD2）：深蓝黑底，状态栏浅色图标 -->
    <style name="Theme.GitCove" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:statusBarColor">@color/launch_bg</item>
        <item name="android:navigationBarColor">@color/launch_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
</resources>
